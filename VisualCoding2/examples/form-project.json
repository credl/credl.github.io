    "code": "Dim x As Double\nDim y As Double\nDim dx As Double\nDim dy As Double\nDim speed as Double\nDim running As Boolean\n\nSub Form_Load()\n    speed = 0.8    \nEnd Sub\n\nSub button6_Click()\n    button1.Left = button1.Left + 5\n    MsgBox(\"Hello World!\")\n    canvas1.DrawCircle(10,10,5)\nEnd Sub\n\nSub canvas1_Click()\n\nEnd Sub\n\nSub btnCircleWalk_Click()\n    If running Then\n        StopTimer\n        running = False\n        Button1.Caption = \"Start\"\n    Else\n        x = Canvas1.Width / 2\n        y = Canvas1.Height / 2\n        dx = 3\n        dy = 2\n        running = True\n        Button1.Caption = \"Stop\"\n        StartTimer 20\n    End If\nEnd Sub\n\nSub Form_Timer()\n    Const R = 12\n    ' wander: nudge the direction a little, keep the speed within limits\n    dx = dx + (Rnd - 0.5) * 0.8\n    dy = dy + (Rnd - 0.5) * 0.8\n    If dx > 4 Then dx = 4\n    If dx < -4 Then dx = -4\n    If dy > 4 Then dy = 4\n    If dy < -4 Then dy = -4\n    x = x + dx * speed\n    y = y + dy * speed\n    ' bounce off the edges\n    If x < R Then\n        x = R\n        dx = -dx\n    End If\n    If x > Canvas1.Width - R Then\n        x = Canvas1.Width - R\n        dx = -dx\n    End If\n    If y < R Then\n        y = R\n        dy = -dy\n    End If\n    If y > Canvas1.Height - R Then\n        y = Canvas1.Height - R\n        dy = -dy\n    End If\n    ' clear and redraw in the same step, so the screen never shows an empty canvas\n    Canvas1.Clear\n    Canvas1.DrawColor = \"#2a7\"\n    Canvas1.FillCircle x, y, R\nEnd Sub\n\nSub slider1_Change()\n    speed = slider1.value / 100\n    Counter2.SetValue(slider1.value)\nEnd Sub\n",
